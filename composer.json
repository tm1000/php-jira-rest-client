{
  "name": "lesstif/php-jira-rest-client",
  "description": "JIRA REST API Client for PHP Users.",
  "type": "library",
  "keywords": [
    "jira",
    "rest",
    "jira-php",
    "jira-rest"
  ],
  "require": {
    "php": "^8.4",
    "netresearch/jsonmapper": "^5.0",
    "monolog/monolog": "^3.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "suggest": {
    "vlucas/phpdotenv": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6",
    "symfony/var-dumper": "^6.0|^7.0",
    "vimeo/psalm": "^6.0",
    "rector/rector": "^2.0",
    "squizlabs/php_codesniffer": "^3.11.3"
  },
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "KwangSeob Jeong",
      "email": "lesstif@gmail.com",
      "homepage": "https://lesstif.com/"
    }
  ],
  "autoload": {
    "psr-4": {
      "JiraRestApi\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JiraRestApi\\Test\\": "tests"
    }
  },
  "scripts": {
    "psalm": "psalm",
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpcbf": "phpcbf --standard=phpcs.xml",
    "test": "XDEBUG_MODE=coverage,debug phpunit --configuration phpunit.xml",
    "test:filter": "XDEBUG_MODE=coverage,debug phpunit --configuration phpunit.xml --filter",
    "rector": "rector && npm run prettier"
  }
}
